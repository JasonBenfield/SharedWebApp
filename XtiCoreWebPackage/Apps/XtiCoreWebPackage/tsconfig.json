{
  "compilerOptions": {
    "lib": [ "ES2022", "dom" ],
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es2022",
    "importHelpers": true,
    "baseUrl": ".",
    "typeRoots": [
      "../../node_modules/@types"
    ]
  },
  "include": [
  ],
  "exclude": [
    "Imports",
    "node_modules",
    "wwwroot"
  ]
}